  "outbound": [
    {
      "id": "earnings",
      "label": "Earnings (one row per employee per pay code)",
      "layout": "long",
      "filename": "payroll_import_{period_end}.csv",
      "include": "all",
      "blank_amount_for_hours": false,
      "columns": [
        [
          "Employee ID",
          "payroll_id"
        ],
        [
          "Employee Name",
          "name"
        ],
        [
          "Location",
          "location_code"
        ],
        [
          "Pay Code",
          "code"
        ],
        [
          "Description",
          "label"
        ],
        [
          "Hours",
          "hours_always"
        ],
        [
          "Rate",
          "rate"
        ],
        [
          "Amount",
          "amount"
        ],
        [
          "Period Start",
          "date:period_start|iso"
        ],
        [
          "Period End",
          "date:period_end|iso"
        ]
      ]
    }
  ]

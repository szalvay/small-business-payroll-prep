        "rate_effective": [
          "Rate Effective Date",
          "Effective Date"
        ],
        "email": [
          "Work Email",
          "Email"
        ]
      },
      "value_maps": {
        "status": {
          "active": "active",
          "a": "active",
          "employed": "active",
          "full-time": "active",
          "part-time": "active",
          "full time": "active",
          "part time": "active",
          "terminated": "terminated",
          "t": "terminated",
          "inactive": "terminated",
          "leave": "leave",
          "l": "leave",
          "leave of absence": "leave",

          "Start Date",
          "Start",
          "From"
        ],
        "end_date": [
          "End Date",
          "End",
          "To"
        ],
        "type": [
          "Type",
          "Time Off Type",
          "Category",
          "Policy"
        ],
        "hours": [
          "Hours",
          "Hours Used",
          "Amount",
          "Total Hours"
        ]
      },
      "type_map": {
        "sick": "sick",
        "sick leave": "sick",
        "sick time": "sick",

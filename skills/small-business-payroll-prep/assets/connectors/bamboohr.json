          "Last name",
          "Surname"
        ],
        "status": [
          "Status",
          "Employment Status",
          "Employee Status"
        ],
        "hire_date": [
          "Hire Date",
          "Start Date",
          "Original Hire Date"
        ],
        "termination_date": [
          "Termination Date",
          "Term Date"
        ],
        "location": [
          "Location",
          "Work Location",
          "Site"
        ],
        "job_title": [
          "Job Title",
          "Title",
          "Position"
        ],
        "pay_rate": [
          "Pay Rate",
          "Rate",
          "Base Rate",
          "Hourly Rate",
          "Salary"
        ],
        "pay_type": [
          "Pay Type",
          "Rate Type"
        ],
        "pay_per": [
          "Pay Per",
          "Paid Per",
          "Pay Period"
        ],
        "rate_effective": [
          "Compensation: Date",
          "Pay Rate Effective Date",
          "Effective Date"
        ],
        "email": [
          "Work Email",
          "Email"
        ]
      },
      "value_maps": {
        "status": {
          "active": "active",
          "a": "active",
          "employed": "active",
          "full-time": "active",
          "part-time": "active",
          "full time": "active",
          "part time": "active",
          "terminated": "terminated",
          "t": "terminated",
          "inactive": "terminated",
          "leave": "leave",
          "l": "leave",
          "leave of absence": "leave",
          "on leave": "leave"
        }
      }
    },
    "time_off": {
      "columns": {
        "employee_id": [
          "Employee #",
          "Employee Number",
          "Employee ID"
        ],
        "employee_name": [
          "Employee Name",
          "Name",
          "Employee"
        ],
        "date": [
          "Date",
          "Date Taken"
        ],
        "start_date": [
          "Start Date",
          "Start",
          "From"
        ],
        "end_date": [
          "End Date",
          "End",
          "To"
        ],
        "type": [
          "Time Off Type",
          "Type",
          "Category",
          "Policy"
        ],
        "hours": [
          "Hours",
          "Amount",
          "Hours Used",
          "Used (Hours)"
        ]
      },
      "type_map": {
        "sick": "sick",
        "sick leave": "sick",
        "sick time": "sick",
        "paid sick": "sick",
        "pto": "pto",
        "paid time off": "pto",
        "vacation": "pto",
        "personal": "pto",
        "holiday": "holiday",
        "bereavement": "bereavement",
        "jury duty": "jury_duty",
        "unpaid": "unpaid",
        "unpaid leave": "unpaid"
      }
    }
  },
  "outbound": [
    {
      "id": "hours",
      "label": "Import Hours (hourly REG / OT / DT)",
      "layout": "long",
      "include": "hours",
      "filename": "bamboohr_import_hours_{period_end}.csv",
      "include_rate": false,
      "rate_type_map": {
        "regular": "REG",
        "overtime": "OT",
        "doubletime": "DT",
        "default": "REG"
      },
      "columns": [
        [
          "Employee #",
          "payroll_id"
        ],
        [
